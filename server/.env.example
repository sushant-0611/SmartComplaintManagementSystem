# MongoDB Atlas connection string
# Atlas -> Cluster -> Connect -> Drivers -> copy the string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart_complaints?retryWrites=true&w=majority

# JWT secret - any long random string
JWT_SECRET=change_this_to_a_long_random_secret_string

# Token expiry (optional, default 7d)
JWT_EXPIRES_IN=7d

# Server port (optional, default 5000)
PORT=5000

# Frontend URL for CORS (optional, default http://localhost:5173)
CLIENT_URL=http://localhost:5173

# development | production
NODE_ENV=development
